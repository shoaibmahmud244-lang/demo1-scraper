{
  "_comment": "One block per site. Adding a site means adding a block here - scraper.py needs no code change. Respect robots.txt and the target's terms: only scrape what you are allowed to scrape.",
  "sites": [
    {
      "name": "books",
      "url": "https://books.toscrape.com/",
      "page_url": "https://books.toscrape.com/catalogue/page-{page}.html",
      "max_pages": 50,
      "delay": 0.3,
      "id_field": "url",
      "item_selector": "article.product_pod",
      "fields": {
        "title":        { "selector": "h3 a", "attr": "title" },
        "price":        { "selector": "p.price_color", "regex": "([£$€]?[0-9]+[.,][0-9]{2})" },
        "availability": { "selector": "p.instock.availability" },
        "rating":       { "selector": "p.star-rating", "attr": "class",
                          "map": { "One": 1, "Two": 2, "Three": 3, "Four": 4, "Five": 5 } },
        "url":          { "selector": "h3 a", "attr": "href", "absolute": true }
      }
    },
    {
      "name": "quotes",
      "url": "https://quotes.toscrape.com/",
      "max_pages": 1,
      "delay": 0.5,
      "id_field": "text",
      "item_selector": "div.quote",
      "fields": {
        "text":       { "selector": "span.text", "regex": "\u201c(.+?)\u201d" },
        "author":     { "selector": "small.author" },
        "author_url": { "selector": "a[href*='/author/']", "attr": "href", "absolute": true },
        "tags":       { "selector": "a.tag", "all": true }
      }
    }
  ]
}
